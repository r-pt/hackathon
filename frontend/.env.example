# Desarrollo local: backend FastAPI en http://localhost:8000
# Producción con Vercel Services: dejar vacío (usa /api/v1/* en el mismo origen) o indicar URL HTTPS externa si el backend se despliega por separado
VITE_API_URL=http://localhost:8000

# Supabase Auth (solo login / reporte de incidencias)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Variables de entorno para escaleras (subida de piso P1<->P2 y elevaciones)
VITE_ENABLE_FLOOR_STAIRS=true
VITE_ENABLE_ELEVATION_STAIRS=true
VITE_DEFAULT_AVOID_STAIRS=false
