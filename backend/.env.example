# Supabase (Persona A configura este proyecto en Fase 0 / Hora 1)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# CORS (separado por comas; incluir localhost:5173 y dominio Vercel)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,https://campusroute-frontend.vercel.app,https://campusroute-frontend-hackathon-e4ab.vercel.app

# Coordenadas del campus para Open-Meteo (Persona B — default UTFSM Casa Central, Valparaíso)
CAMPUS_LAT=-33.0344
CAMPUS_LON=-71.5950

# Escaleras y desniveles (ruteo entre pisos y pendientes exteriores)
ENABLE_FLOOR_STAIRS=true
ENABLE_ELEVATION_STAIRS=true
STAIR_STEP_PENALTY_SECONDS=0.7
ELEVATION_SLOPE_PENALTY_FACTOR=1.5
